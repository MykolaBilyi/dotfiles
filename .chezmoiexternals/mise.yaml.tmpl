{{- if not (lookPath "mise") -}}
{{- $OS := .chezmoi.os -}}
{{- $OS := eq .chezmoi.os "android" | ternary "linux" $OS -}}
{{- $ARCH := eq .chezmoi.arch "amd64" | ternary "x64" .chezmoi.arch -}}
{{- $ARCH := eq .chezmoi.arch "arm" | ternary "armv7" $ARCH -}}
".local/bin/mise":
  type: archive-file
  executable: true
  path: mise/bin/mise
  url: {{ gitHubLatestReleaseAssetURL "jdx/mise" (printf "mise-*-%s-%s-musl.tar.xz" $OS $ARCH) | quote }}
{{- end -}}
